# Environment Variables Template

# Backend (.env in server/)
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://user_name:password@cluster_name.0gpi1xa.mongodb.net/food-donation-network?retryWrites=true&w=majority

# Firebase Admin SDK
FIREBASE_PROJECT_ID=food-management
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n_ADD_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=""

# CORS
CORS_ORIGIN=http://localhost:5173

# Frontend (.env in client/)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Firebase Web SDK Config
VITE_FIREBASE_API_KEY=firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=1:""
